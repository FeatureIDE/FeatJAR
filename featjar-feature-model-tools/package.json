{
  "name": "featjar-extension",
  "displayName": "FeatJAR Extension",
  "description": "Provides tools for creating, editing, and analyzing FeatJAR feature models in Visual Studio Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["workspaceContains:**/*.uvl"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "featjar-extension.checkSatisfiability",
        "title": "Check Satisfiability"
      },
       {
        "command": "featjar-extension.openGui",
        "title": "FeatJAR: Open GUI"
      },
      {
        "command": "featjar-extension.TestCommand",
        "title": "FeatJAR: Test command"
      },
      {
        "command": "featjar-extension.countConfigurations",
       "title": "Count Configurations"
      },
      {
        "command": "featjar-extension.coreDeadFeatures",
       "title": "Count Core/Dead Features"
      },
      {
        "command": "featjar-extension.modelTest",
       "title": "model stats "
      },
      {
        "command": "featjar-extension.refreshUvlFiles",
        "title": "Refresh UVL Files",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "featjar-extension.checkSatisfiability",
          "when": "resourceExtname == .uvl || resourceExtname == .xml || resourceExtname == .dimacs"
        },
        {
          "command": "featjar-extension.openGui",
          "when": "resourceExtname == .uvl"
        }
      ],
      "view/item/context": [
    {
        "command": "featjar-extension.checkSatisfiability",
        "when": "view == uvlFiles"
    },
    {
        "command": "featjar-extension.countConfigurations",
        "when": "view == uvlFiles"
    },{
        "command": "featjar-extension.coreDeadFeatures",
        "when": "view == uvlFiles"
    },{
        "command": "featjar-extension.modelTest",
        "when": "view == uvlFiles"
    }
    ],
    "view/title": [
    {
        "command": "featjar-extension.refreshUvlFiles",
        "when": "view == uvlFiles",
        "group": "navigation"
    }
]
    },
    "customEditors": [
      {
        "viewType": "featjar-extension.uvlEditor",
        "displayName": "FeatJAR GUI",
        "selector": [
          {
            "filenamePattern": "*.uvl"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "featjarBar",
          "title": "FeatJar",
          "icon": "resources/treeICON.svg"
        }
      ]
    },
    "views": {
      "featjarBar": [
        {
          "id": "uvlFiles",
          "name": "UVL Files",
          "icon": "resources/treeICON.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}