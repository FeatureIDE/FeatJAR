{
  "name": "gui-client-web",
  "version": "1.0.0",
  "private": true,
  "description": "Web front-end to display FeatJAR feature models",
  "homepage": "https://github.com/FeatureIDE/FeatJAR",
  "bugs": "https://github.com/FeatureIDE/FeatJAR/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/FeatureIDE/FeatJAR.git"
  },
  "author": {
    "name": "FeatJAR-Development-Team"
  },
  "contributors": [
    {
      "name": "FeatureIDE Organization",
      "email": "sebastian.krieter@tu-braunschweig.de",
      "url": "https://github.com/FeatureIDE"
    },
    {
      "name": "Eclipse GLSP Project",
      "email": "glsp-dev@eclipse.org",
      "url": "https://projects.eclipse.org/projects/ecd.glsp"
    }
  ],
  "main": "lib",
  "types": "lib",
  "scripts": {
    "all": "yarn clean && yarn install && yarn lint && yarn test",
    "build": "yarn compile && yarn bundle",
    "bundle": "webpack",
    "clean:build": "rm -rf lib *.tsbuildinfo app/bundle.js app/bundle.js.map app/css",
    "clean": "yarn clean:build && rm -rf node_modules yarn.lock",
    "reset": "yarn clean && yarn install",
    "compile": "tsc -b",
    "lint": "eslint --ext .ts,.tsx ./src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "watch": "tsc -w && yarn watch:bundle",
    "watch:bundle": "webpack -w"
  },
  "dependencies": {
    "@eclipse-glsp/client": "2.6.0",
    "@vscode/codicons": "^0.0.36",
    "inversify-logger-middleware": "^3.1.0"
  },
  "devDependencies": {
    "@eclipse-glsp/dev": "2.6.0",
    "@eclipse-glsp/prettier-config": "^2.7.0",
    "@types/lodash": "4.14.191",
    "@types/node": "20.x",
    "@types/tar": "6.1.5",
    "balloon-css": "^0.5.0",
    "circular-dependency-plugin": "^5.2.2",
    "concurrently": "^8.2.2",
    "css-loader": "^6.7.1",
    "inversify": "^6.1.3",
    "lerna": "^9.0.0",
    "mocha-ctrf-json-reporter": "^0.0.9",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.6",
    "process": "^0.11.10",
    "source-map-loader": "^4.0.0",
    "style-loader": "^3.3.1",
    "typescript": "^5.9.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=1.7.0 <2"
  },
  "publishConfig": {
    "access": "public"
  }
}
